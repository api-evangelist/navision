{
  "opencollection": "1.0.0",
  "info": {
    "name": "Business Central Administration Center Accounts API",
    "version": "2.28"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://login.microsoftonline.com/{tenantId}/oauth2/v2.0/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.businesscentral.dynamics.com/admin/v2.28/companies(:company_id)/accounts",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the company"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of items to skip"
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "OData filter expression"
              },
              {
                "name": "$orderby",
                "value": "",
                "type": "query",
                "description": "OData order by expression"
              },
              {
                "name": "$select",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of properties to include in the response"
              }
            ]
          },
          "docs": "Returns a list of general ledger account objects."
        },
        {
          "info": {
            "name": "Get an Account",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.businesscentral.dynamics.com/admin/v2.28/companies(:company_id)/accounts(:account_id)",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the company"
              },
              {
                "name": "account_id",
                "value": "500123",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieves a specific account by ID."
        },
        {
          "info": {
            "name": "List General Ledger Entries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.businesscentral.dynamics.com/admin/v2.28/companies(:company_id)/generalLedgerEntries",
            "params": [
              {
                "name": "company_id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the company"
              },
              {
                "name": "$top",
                "value": "",
                "type": "query",
                "description": "Maximum number of items to return"
              },
              {
                "name": "$skip",
                "value": "",
                "type": "query",
                "description": "Number of items to skip"
              },
              {
                "name": "$filter",
                "value": "",
                "type": "query",
                "description": "OData filter expression"
              },
              {
                "name": "$orderby",
                "value": "",
                "type": "query",
                "description": "OData order by expression"
              },
              {
                "name": "$select",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of properties to include in the response"
              }
            ]
          },
          "docs": "Returns a list of general ledger entries."
        }
      ]
    }
  ],
  "bundled": true
}